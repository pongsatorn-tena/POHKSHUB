-- ฟังก์ชันจำลองการกดปุ่มและเมาส์
local function setKeyState(keyCode, isPressed)
    VirtualInputManager:SendKeyEvent(isPressed, keyCode, false, game)
end

local function pressKey(keyCode, holdTime)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(holdTime or 0.05)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function clickMouse(isRight)
    local button = isRight and Enum.UserInputType.MouseButton2 or Enum.UserInputType.MouseButton1
    VirtualInputManager:SendMouseButtonEvent(0, 0, button.Value, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, button.Value, false, game, 1)
end

-- ฟังก์ชันกระโดดแบบจำลองการกด Spacebar ชัวร์ 100%
local function triggerJump()
    task.spawn(function()
        task.wait(0.1) -- หน่วงเวลารอให้พิกัดวาร์ปนิ่งสนิท
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

