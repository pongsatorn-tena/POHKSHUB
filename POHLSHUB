-- ปุ่มออโต้เดินโยกซ้ายขวา + แดช
MoveDashBtn.MouseButton1Click:Connect(function()
    ToggleState.AutoMoveDash = not ToggleState.AutoMoveDash
    if ToggleState.AutoMoveDash then
        MoveDashBtn.Text = "🏃 โยกซ้ายขวา+แดช: เปิด"
        MoveDashBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        StatusLabel.Text = "สถานะ: กำลังโยกซ้ายขวาและแดช..."
        task.spawn(function()
            while ToggleState.AutoMoveDash do
                setKeyState(Enum.KeyCode.A, true)
                task.wait(0.4)
                pressKey(Enum.KeyCode.E, 0.08)
                task.wait(0.3)
                setKeyState(Enum.KeyCode.A, false)

                if not ToggleState.AutoMoveDash then break end

                setKeyState(Enum.KeyCode.D, true)
                task.wait(0.4)
                pressKey(Enum.KeyCode.E, 0.08)
                task.wait(0.3)
                setKeyState(Enum.KeyCode.D, false)

                task.wait(0.2)
            end
            setKeyState(Enum.KeyCode.A, false)
            setKeyState(Enum.KeyCode.D, false)
        end)
    else
        MoveDashBtn.Text = "🏃 โยกซ้ายขวา+แดช: ปิด"
        MoveDashBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        setKeyState(Enum.KeyCode.A, false)
        setKeyState(Enum.KeyCode.D, false)
        StatusLabel.Text = "สถานะ: หยุดการโยกและแดชแล้ว"
    end
end)

